{
  "info": {
    "_postman_id": "researchflow-phase6-events",
    "name": "ResearchFlow Backend — Phase 6 Agents Events & SSE",
    "description": "Phase 6: agent observability + SSE.\n\nApply migrations/006_create_agent_events.sql first.\nbaseUrl=http://localhost:8000\n\nNote: GET /stream is Server-Sent Events — use Postman's SSE support or curl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "runId", "value": "" },
    { "key": "agentName", "value": "planner-01" },
    { "key": "afterId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup (create + plan + approve)",
      "item": [
        {
          "name": "POST Create Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('runId', b.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"AI diagnostics observability test\",\n  \"depth\": \"quick\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/runs"
          }
        },
        {
          "name": "POST Generate Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/generate"
          }
        },
        {
          "name": "POST Approve Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/approve"
          }
        },
        {
          "name": "POST Start Research",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/start"
          }
        }
      ]
    },
    {
      "name": "Agents",
      "item": [
        {
          "name": "GET Agents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/agents"
          }
        },
        {
          "name": "GET Agents Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/agents/status"
          }
        },
        {
          "name": "GET Agent by Name",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/agents/{{agentName}}"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "GET Events",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.items && b.data.items.length) {",
                  "  pm.collectionVariables.set('afterId', b.data.items[0].id);",
                  "  pm.collectionVariables.set('agentName', b.data.items[0].agent_name);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/runs/{{runId}}/events?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "runs", "{{runId}}", "events"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" },
                { "key": "event_type", "value": "", "disabled": true },
                { "key": "agent_name", "value": "", "disabled": true },
                { "key": "after_id", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET Events after_id (replay cursor)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/events?after_id={{afterId}}&limit=50"
          }
        },
        {
          "name": "GET Error Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/events?event_type=error"
          }
        },
        {
          "name": "GET Stream SSE",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/event-stream" },
              { "key": "Last-Event-ID", "value": "{{afterId}}", "disabled": true }
            ],
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/stream?replay=true",
            "description": "Long-lived SSE connection. Prefer curl for local testing:\ncurl -N -H 'Accept: text/event-stream' '{{baseUrl}}/api/v1/runs/{{runId}}/stream?replay=true'"
          }
        }
      ]
    }
  ]
}
