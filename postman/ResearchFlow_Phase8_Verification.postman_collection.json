{
  "info": {
    "_postman_id": "researchflow-phase8-verification",
    "name": "ResearchFlow Backend — Phase 8 Verifier & Quality",
    "description": "Phase 8: Verifier Agent + quality checks.\n\nApply migrations/008_verification_fields_and_events.sql first.\nPrereq: run with generated report + findings/sources.\nbaseUrl=http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "runId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup (report must exist)",
      "item": [
        {
          "name": "POST Create Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('runId', b.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"AI diagnostics verification test\",\n  \"depth\": \"quick\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/runs"
          }
        },
        {
          "name": "POST Generate Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/generate"
          }
        },
        {
          "name": "POST Approve Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/approve"
          }
        },
        {
          "name": "POST Start Research",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/start"
          }
        },
        {
          "name": "GET Research Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/status"
          }
        },
        {
          "name": "POST Generate Report",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/report/generate"
          }
        }
      ]
    },
    {
      "name": "Verification",
      "item": [
        {
          "name": "POST Verify",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/verify"
          }
        },
        {
          "name": "GET Verification",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/verification"
          }
        },
        {
          "name": "GET Conflicts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/conflicts"
          }
        }
      ]
    }
  ]
}
