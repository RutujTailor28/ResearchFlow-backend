{
  "info": {
    "_postman_id": "researchflow-phase5-research",
    "name": "ResearchFlow Backend — Phase 5 Multi-Agent Research & Findings",
    "description": "Phase 5: LangGraph multi-researcher orchestration + findings CRUD.\n\nApply migrations/005_create_findings_and_research_tasks.sql first.\nPrereq: run approved with plan sections/sub-questions.\nbaseUrl=http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "runId", "value": "" },
    { "key": "sectionId", "value": "" },
    { "key": "findingId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "POST Create Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('created', () => pm.expect(b.success).to.eql(true));",
                  "pm.collectionVariables.set('runId', b.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"AI diagnostics in healthcare\",\n  \"depth\": \"standard\",\n  \"audience\": \"technical\",\n  \"tone\": \"professional\",\n  \"target_length\": 3000,\n  \"source_types\": [\"official\", \"research\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/runs"
          }
        },
        {
          "name": "POST Generate Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/generate"
          }
        },
        {
          "name": "POST Approve Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/approve"
          }
        },
        {
          "name": "GET List Sections",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.items && b.data.items.length) {",
                  "  pm.collectionVariables.set('sectionId', b.data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/sections"
          }
        }
      ]
    },
    {
      "name": "Research Orchestration",
      "item": [
        {
          "name": "POST Start Research",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/start"
          }
        },
        {
          "name": "GET Research Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/status"
          }
        },
        {
          "name": "GET Research Results",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/results"
          }
        },
        {
          "name": "POST Retry Research",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/retry"
          }
        }
      ]
    },
    {
      "name": "Findings",
      "item": [
        {
          "name": "GET List Findings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.items && b.data.items.length) {",
                  "  pm.collectionVariables.set('findingId', b.data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/findings"
          }
        },
        {
          "name": "GET Finding by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/findings/{{findingId}}"
          }
        },
        {
          "name": "GET Section Findings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/sections/{{sectionId}}/findings"
          }
        },
        {
          "name": "POST Create Finding",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data && b.data.id) pm.collectionVariables.set('findingId', b.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"section_id\": \"{{sectionId}}\",\n  \"claim\": \"Manual paraphrased claim added after review.\",\n  \"confidence\": 0.6,\n  \"is_gap\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/findings"
          }
        },
        {
          "name": "PUT Update Finding",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claim\": \"Updated paraphrased claim.\",\n  \"confidence\": 0.75\n}"
            },
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/findings/{{findingId}}"
          }
        },
        {
          "name": "DELETE Finding",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/findings/{{findingId}}"
          }
        }
      ]
    }
  ]
}
