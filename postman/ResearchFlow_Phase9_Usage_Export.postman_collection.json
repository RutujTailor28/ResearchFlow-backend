{
  "info": {
    "_postman_id": "researchflow-phase9-usage-export",
    "name": "ResearchFlow Backend — Phase 9 Usage, Export, History",
    "description": "Phase 9: Usage tracking, cost, export (md/pdf/docx), history, and timeline replay.\n\nNo new migration required — aggregates stored agent_events + reports.\nPrereq: run with events (plan/research/report) and a generated report for exports.\nbaseUrl=http://localhost:8000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "runId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "POST Create Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('runId', b.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Usage export history phase nine\",\n  \"depth\": \"quick\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/runs"
          }
        },
        {
          "name": "POST Generate Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/generate"
          }
        },
        {
          "name": "POST Approve Plan",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/plan/approve"
          }
        },
        {
          "name": "POST Start Research",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/start"
          }
        },
        {
          "name": "GET Research Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/research/status"
          }
        },
        {
          "name": "POST Generate Report",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/report/generate"
          }
        }
      ]
    },
    {
      "name": "Usage & Cost",
      "item": [
        {
          "name": "GET Usage",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/usage"
          }
        },
        {
          "name": "GET Cost",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/cost"
          }
        }
      ]
    },
    {
      "name": "History & Replay",
      "item": [
        {
          "name": "GET Runs (history list)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs?limit=20"
          }
        },
        {
          "name": "GET Run History + Timeline",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/history"
          }
        },
        {
          "name": "GET Events (compare timeline)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/runs/{{runId}}/events?limit=100"
          }
        }
      ]
    },
    {
      "name": "Export",
      "item": [
        {
          "name": "GET Export Markdown",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/runs/{{runId}}/export?format=md",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "runs", "{{runId}}", "export"],
              "query": [{ "key": "format", "value": "md" }]
            }
          }
        },
        {
          "name": "GET Export PDF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/runs/{{runId}}/export?format=pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "runs", "{{runId}}", "export"],
              "query": [{ "key": "format", "value": "pdf" }]
            }
          }
        },
        {
          "name": "GET Export DOCX",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/runs/{{runId}}/export?format=docx",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "runs", "{{runId}}", "export"],
              "query": [{ "key": "format", "value": "docx" }]
            }
          }
        }
      ]
    }
  ]
}
